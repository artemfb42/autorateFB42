        ["id=firstName", "id"],
        ["name=firstName", "name"],
        ["css=#firstName", "css:finder"],
        ["xpath=//input[@id='firstName']", "xpath:attributes"],
        ["xpath=//div[2]/input", "xpath:position"]
      ],
      "value": "Test"
    }, {
      "id": "04ca80b6-f2c8-4e90-a985-75a6f9a960f6",
      "comment": "",
      "command": "type",
      "target": "id=lastName",
