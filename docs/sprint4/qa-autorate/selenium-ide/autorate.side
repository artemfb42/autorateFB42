        ["id=lastName", "id"],
        ["name=lastName", "name"],
        ["css=#lastName", "css:finder"],
        ["xpath=//input[@id='lastName']", "xpath:attributes"],
        ["xpath=//div[3]/input", "xpath:position"]
      ],
      "value": "Tester"
    }, {
      "id": "2fe03853-9bce-4a23-af36-1ba26a9e5ca0",
      "comment": "",
      "command": "type",
      "target": "id=password",
