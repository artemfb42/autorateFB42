      "id": "3316ade6-59fc-4eda-9f34-02332b8fd0f6",
      "comment": "",
      "command": "type",
      "target": "id=confirmPassword",
      "targets": [],
      "value": "Pass1235a@"
    }, {
      "id": "c9aae2b9-84a9-4444-96cb-06424de67514",
      "comment": "",
      "command": "waitForElementVisible",
      "target": "css=#confirmPassword + div.alert-danger",
