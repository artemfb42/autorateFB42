      "target": "1280x900",
      "targets": [],
      "value": ""
    }, {
      "id": "82d52a8c-efd7-4540-bb71-6d71453cd813",
      "comment": "",
      "command": "click",
      "target": "css=my-login a[href='/register']",
      "targets": [
        ["linkText=Register", "linkText"],
        ["css=.btn-success-outline", "css:finder"],
        ["xpath=//a[contains(text(),'Register')]", "xpath:link"],
        ["xpath=//a[contains(@href, '/register')]", "xpath:href"],
        ["xpath=//form/a", "xpath:position"],
        ["xpath=//a[contains(.,'Register')]", "xpath:innerText"]
