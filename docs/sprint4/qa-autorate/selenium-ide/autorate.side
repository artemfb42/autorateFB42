      "id": "bb3d9532-2333-4bab-bc8b-1cf2169622cd",
      "comment": "",
      "command": "waitForElementVisible",
      "target": "id=username",
      "targets": [],
      "value": "10000"
    }, {
      "id": "aa145479-4e90-41db-8213-9ced6728697d",
      "comment": "",
      "command": "type",
      "target": "id=username",
      "targets": [
        ["id=username", "id"],
        ["name=username", "name"],
        ["css=#username", "css:finder"],
        ["xpath=//input[@id='username']", "xpath:attributes"],
        ["xpath=//div/div/form/div/input", "xpath:position"]
      ],
      "value": "fb42_tc005"
    }, {
      "id": "0198b6af-bf94-4090-913f-b7ca558dab42",
      "comment": "",
      "command": "type",
      "target": "id=firstName",
