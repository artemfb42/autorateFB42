<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Vote" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.30.1">
  <bpmn:collaboration id="Collaboration_Vote">
    <bpmn:participant id="Participant_User" name="Користувач" processRef="Process_User" />
    <bpmn:participant id="Participant_AutoRate" name="АвтоРейт" processRef="Process_AutoRate" />
    <bpmn:messageFlow id="MF_Request" sourceRef="U_SendRequest" targetRef="S_StartRequest" />
    <bpmn:messageFlow id="MF_NeedAuth" sourceRef="S_SendNeedAuth" targetRef="U_CatchNeedAuth" />
    <bpmn:messageFlow id="MF_Repeat" sourceRef="S_SendRepeat" targetRef="U_CatchRepeat" />
    <bpmn:messageFlow id="MF_Form" sourceRef="S_SendForm" targetRef="U_CatchForm" />
    <bpmn:messageFlow id="MF_VoteData" sourceRef="U_SendVote" targetRef="S_CatchVote" />
    <bpmn:messageFlow id="MF_Invalid" sourceRef="S_SendInvalid" targetRef="U_CatchInvalid" />
    <bpmn:messageFlow id="MF_Success" sourceRef="S_SendSuccess" targetRef="U_CatchSuccess" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:eventBasedGateway id="U_WaitResult" name="Очікувати результат">
      <bpmn:incoming>UF10</bpmn:incoming>
      <bpmn:outgoing>UF11</bpmn:outgoing>
      <bpmn:outgoing>UF12</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sendTask id="U_SendVote" name="Надіслати оцінку та коментар">
      <bpmn:incoming>UF9</bpmn:incoming>
      <bpmn:outgoing>UF10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="U_CatchNeedAuth" name="Потрібна авторизація">
      <bpmn:incoming>UF3</bpmn:incoming>
      <bpmn:outgoing>UF6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="U_WaitAccess" name="Очікувати відповідь">
      <bpmn:incoming>UF2</bpmn:incoming>
      <bpmn:outgoing>UF3</bpmn:outgoing>
      <bpmn:outgoing>UF4</bpmn:outgoing>
      <bpmn:outgoing>UF5</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sendTask id="U_SendRequest" name="Надіслати запит на голосування">
      <bpmn:incoming>UF1</bpmn:incoming>
      <bpmn:outgoing>UF2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="U_Start" name="Натиснуто «Голосувати»">
      <bpmn:outgoing>UF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="U_EndAuth" name="Голосування недоступне">
      <bpmn:incoming>UF6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="U_CatchRepeat" name="Повторне голосування заборонено">
      <bpmn:incoming>UF4</bpmn:incoming>
      <bpmn:outgoing>Flow_1gmm3ef</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="U_EndRepeat" name="Повторний голос відхилено">
      <bpmn:incoming>Flow_1gmm3ef</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="U_CatchForm" name="Форму голосування отримано">
      <bpmn:incoming>UF5</bpmn:incoming>
      <bpmn:outgoing>UF8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="U_EnterVote" name="Обрати оцінку 1–5 і написати коментар">
      <bpmn:incoming>UF8</bpmn:incoming>
      <bpmn:outgoing>UF9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="U_EndSuccess" name="Голосування завершено">
      <bpmn:incoming>UF14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="U_CatchSuccess" name="Голос враховано">
      <bpmn:incoming>UF12</bpmn:incoming>
      <bpmn:outgoing>UF14</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="U_CatchInvalid" name="Помилка валідації">
      <bpmn:incoming>UF11</bpmn:incoming>
      <bpmn:outgoing>UF13</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="U_EndInvalid" name="Дані не прийнято">
      <bpmn:incoming>UF13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="UF10" sourceRef="U_SendVote" targetRef="U_WaitResult" />
    <bpmn:sequenceFlow id="UF11" sourceRef="U_WaitResult" targetRef="U_CatchInvalid" />
    <bpmn:sequenceFlow id="UF12" sourceRef="U_WaitResult" targetRef="U_CatchSuccess" />
    <bpmn:sequenceFlow id="UF9" sourceRef="U_EnterVote" targetRef="U_SendVote" />
    <bpmn:sequenceFlow id="UF3" sourceRef="U_WaitAccess" targetRef="U_CatchNeedAuth" />
    <bpmn:sequenceFlow id="UF6" sourceRef="U_CatchNeedAuth" targetRef="U_EndAuth" />
    <bpmn:sequenceFlow id="UF2" sourceRef="U_SendRequest" targetRef="U_WaitAccess" />
    <bpmn:sequenceFlow id="UF4" sourceRef="U_WaitAccess" targetRef="U_CatchRepeat" />
    <bpmn:sequenceFlow id="UF5" sourceRef="U_WaitAccess" targetRef="U_CatchForm" />
    <bpmn:sequenceFlow id="UF1" sourceRef="U_Start" targetRef="U_SendRequest" />
    <bpmn:sequenceFlow id="Flow_1gmm3ef" sourceRef="U_CatchRepeat" targetRef="U_EndRepeat" />
    <bpmn:sequenceFlow id="UF8" sourceRef="U_CatchForm" targetRef="U_EnterVote" />
    <bpmn:sequenceFlow id="UF14" sourceRef="U_CatchSuccess" targetRef="U_EndSuccess" />
    <bpmn:sequenceFlow id="UF13" sourceRef="U_CatchInvalid" targetRef="U_EndInvalid" />
  </bpmn:process>
  <bpmn:process id="Process_AutoRate" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AutoRate">
      <bpmn:lane id="Lane_Moderator" name="Модератор">
        <bpmn:flowNodeRef>S_AndJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EndSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Moderation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>S_SendNeedAuth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_GwRepeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_GwValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_CheckAuth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_SendRepeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EndRepeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_GwAuth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_CheckRepeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_SendForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EndAuth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_StartRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EndInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_SendInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_AndSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Recalc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_SendSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_CatchVote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Validate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sendTask id="S_SendNeedAuth" name="Повідомити про необхідність авторизації">
      <bpmn:incoming>SF3</bpmn:incoming>
      <bpmn:outgoing>SF5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="S_GwRepeat" name="Уже голосував?">
      <bpmn:incoming>SF6</bpmn:incoming>
      <bpmn:outgoing>SF7</bpmn:outgoing>
      <bpmn:outgoing>SF8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="S_GwValid" name="Дані валідні?">
      <bpmn:incoming>SF12</bpmn:incoming>
      <bpmn:outgoing>SF13</bpmn:outgoing>
      <bpmn:outgoing>SF14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_CheckAuth" name="Перевірити авторизацію">
      <bpmn:incoming>SF1</bpmn:incoming>
      <bpmn:outgoing>SF2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="S_SendRepeat" name="Повідомити про заборону повторного голосування">
      <bpmn:incoming>SF7</bpmn:incoming>
      <bpmn:outgoing>SF9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="S_EndRepeat" name="Повтор відхилено">
      <bpmn:incoming>SF9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="S_GwAuth" name="Авторизований?">
      <bpmn:incoming>SF2</bpmn:incoming>
      <bpmn:outgoing>SF3</bpmn:outgoing>
      <bpmn:outgoing>SF4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_CheckRepeat" name="Перевірити попередній голос">
      <bpmn:incoming>SF4</bpmn:incoming>
      <bpmn:outgoing>SF6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="S_SendForm" name="Надати форму голосування">
      <bpmn:incoming>SF8</bpmn:incoming>
      <bpmn:outgoing>SF10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="S_EndAuth" name="Запит відхилено">
      <bpmn:incoming>SF5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S_StartRequest" name="Отримано запит">
      <bpmn:outgoing>SF1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:endEvent id="S_EndInvalid" name="Дані відхилено">
      <bpmn:incoming>SF15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="S_SendInvalid" name="Повідомити про помилку валідації">
      <bpmn:incoming>SF13</bpmn:incoming>
      <bpmn:outgoing>SF15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="S_Save" name="Зберегти голос">
      <bpmn:incoming>SF14</bpmn:incoming>
      <bpmn:outgoing>SF16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_Rating">
        <bpmn:targetRef>DS_Rating</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:parallelGateway id="S_AndSplit">
      <bpmn:incoming>SF16</bpmn:incoming>
      <bpmn:outgoing>SF18</bpmn:outgoing>
      <bpmn:outgoing>Flow_0c8f2m0</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="S_Recalc" name="Перерахувати рейтинг моделі й марки">
      <bpmn:incoming>Flow_0c8f2m0</bpmn:incoming>
      <bpmn:outgoing>SF19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="S_SendSuccess" name="Повідомити про врахування голосу">
      <bpmn:incoming>SF21</bpmn:incoming>
      <bpmn:outgoing>SF22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="S_AndJoin">
      <bpmn:incoming>SF19</bpmn:incoming>
      <bpmn:incoming>SF20</bpmn:incoming>
      <bpmn:outgoing>SF21</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="S_CatchVote" name="Отримано оцінку й коментар">
      <bpmn:incoming>SF10</bpmn:incoming>
      <bpmn:outgoing>SF11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="S_Validate" name="Перевірити оцінку 1–5, довжину й стоп-слова">
      <bpmn:incoming>SF11</bpmn:incoming>
      <bpmn:outgoing>SF12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="DS_Rating" name="БД рейтингів" />
    <bpmn:endEvent id="S_EndSuccess" name="Голос оброблено">
      <bpmn:incoming>SF22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="S_Moderation" name="Модерація коментаря">
      <bpmn:incoming>SF18</bpmn:incoming>
      <bpmn:outgoing>SF20</bpmn:outgoing>
      <bpmn:startEvent id="SP_Start">
        <bpmn:outgoing>SPF1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP_Check" name="Перевірити коментар">
        <bpmn:incoming>SPF1</bpmn:incoming>
        <bpmn:outgoing>SPF2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP_End">
        <bpmn:incoming>SPF2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SPF1" sourceRef="SP_Start" targetRef="SP_Check" />
      <bpmn:sequenceFlow id="SPF2" sourceRef="SP_Check" targetRef="SP_End" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="SF3" name="Ні" sourceRef="S_GwAuth" targetRef="S_SendNeedAuth" />
    <bpmn:sequenceFlow id="SF5" sourceRef="S_SendNeedAuth" targetRef="S_EndAuth" />
    <bpmn:sequenceFlow id="SF6" sourceRef="S_CheckRepeat" targetRef="S_GwRepeat" />
    <bpmn:sequenceFlow id="SF7" name="Так" sourceRef="S_GwRepeat" targetRef="S_SendRepeat" />
    <bpmn:sequenceFlow id="SF8" name="Ні" sourceRef="S_GwRepeat" targetRef="S_SendForm" />
    <bpmn:sequenceFlow id="SF12" sourceRef="S_Validate" targetRef="S_GwValid" />
    <bpmn:sequenceFlow id="SF13" name="Ні" sourceRef="S_GwValid" targetRef="S_SendInvalid" />
    <bpmn:sequenceFlow id="SF14" name="Так" sourceRef="S_GwValid" targetRef="S_Save" />
    <bpmn:sequenceFlow id="SF1" sourceRef="S_StartRequest" targetRef="S_CheckAuth" />
    <bpmn:sequenceFlow id="SF2" sourceRef="S_CheckAuth" targetRef="S_GwAuth" />
    <bpmn:sequenceFlow id="SF9" sourceRef="S_SendRepeat" targetRef="S_EndRepeat" />
    <bpmn:sequenceFlow id="SF4" name="Так" sourceRef="S_GwAuth" targetRef="S_CheckRepeat" />
    <bpmn:sequenceFlow id="SF10" sourceRef="S_SendForm" targetRef="S_CatchVote" />
    <bpmn:sequenceFlow id="SF15" sourceRef="S_SendInvalid" targetRef="S_EndInvalid" />
    <bpmn:sequenceFlow id="SF16" sourceRef="S_Save" targetRef="S_AndSplit" />
    <bpmn:sequenceFlow id="SF18" sourceRef="S_AndSplit" targetRef="S_Moderation" />
    <bpmn:sequenceFlow id="Flow_0c8f2m0" sourceRef="S_AndSplit" targetRef="S_Recalc" />
    <bpmn:sequenceFlow id="SF19" sourceRef="S_Recalc" targetRef="S_AndJoin" />
    <bpmn:sequenceFlow id="SF21" sourceRef="S_AndJoin" targetRef="S_SendSuccess" />
    <bpmn:sequenceFlow id="SF22" sourceRef="S_SendSuccess" targetRef="S_EndSuccess" />
    <bpmn:sequenceFlow id="SF20" sourceRef="S_Moderation" targetRef="S_AndJoin" />
    <bpmn:sequenceFlow id="SF11" sourceRef="S_CatchVote" targetRef="S_Validate" />
  </bpmn:process>
