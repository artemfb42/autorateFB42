<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AutoRate_Compact" targetNamespace="https://autorate.example/bpmn/sprint1" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.30.1">
  <collaboration id="Collaboration_Compact">
    <participant id="P_User" name="Користувач" processRef="Proc_User" />
    <participant id="P_System" name="АвтоРейт" processRef="Proc_System" />
    <messageFlow id="M1" sourceRef="U_RegSubmit" targetRef="S_RegStart" />
    <messageFlow id="M2" sourceRef="S_RegOK" targetRef="U_RegOK" />
    <messageFlow id="M3" sourceRef="S_RegFail" targetRef="U_RegFail" />
    <messageFlow id="M4" sourceRef="U_LoginSubmit" targetRef="S_LoginStart" />
    <messageFlow id="M5" sourceRef="S_SendResult" targetRef="U_LoginReceive" />
    <messageFlow id="M6" sourceRef="S_SendBlock" targetRef="U_LoginReceive" />
    <messageFlow id="M7" sourceRef="S_SendBlocked" targetRef="U_LoginReceive" />
    <textAnnotation id="Note_Rules">
      <text>Результат входу містить статус: успіх, невірні дані або чинне блокування. На третій невдалій спробі блокування триває 15 хвилин.</text>
    </textAnnotation>
    <association id="Assoc_Rules" sourceRef="S_Limit" targetRef="Note_Rules" />
  </collaboration>
  <process id="Proc_User" isExecutable="false">
    <startEvent id="U_RegStart" name="Реєстрацію розпочато">
      <outgoing>U1</outgoing>
    </startEvent>
    <sendTask id="U_RegSubmit" name="Ввести й надіслати дані реєстрації" messageRef="M_RegRequest">
      <incoming>U1</incoming>
      <outgoing>U2</outgoing>
    </sendTask>
    <endEvent id="U_RegDone" name="Реєстрацію завершено">
      <incoming>U5</incoming>
    </endEvent>
    <intermediateCatchEvent id="U_RegFail" name="Отримано відмову">
      <incoming>U4</incoming>
      <outgoing>U6</outgoing>
      <messageEventDefinition id="U_RegFail_definition" messageRef="M_RegFail" />
    </intermediateCatchEvent>
    <endEvent id="U_RegRejected" name="Реєстрацію відхилено">
      <incoming>U6</incoming>
    </endEvent>
    <sendTask id="U_LoginSubmit" name="Ввести й надіслати логін і пароль" messageRef="M_LoginRequest">
      <incoming>U7</incoming>
      <outgoing>U8</outgoing>
    </sendTask>
    <receiveTask id="U_LoginReceive" name="Отримати результат входу" messageRef="M_LoginResult">
      <incoming>U8</incoming>
      <outgoing>U9</outgoing>
    </receiveTask>
    <endEvent id="U_LoginEnd" name="Результат входу показано">
      <incoming>U9</incoming>
    </endEvent>
    <eventBasedGateway id="U_RegWait" name="Очікувати результат реєстрації">
      <incoming>U2</incoming>
      <outgoing>U3</outgoing>
      <outgoing>U4</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="U_RegOK" name="Отримано підтвердження">
      <incoming>U3</incoming>
      <outgoing>U5</outgoing>
      <messageEventDefinition id="U_RegOK_definition" messageRef="M_RegOK" />
    </intermediateCatchEvent>
    <startEvent id="U_LoginStart" name="Вхід розпочато">
      <outgoing>U7</outgoing>
    </startEvent>
    <sequenceFlow id="U1" sourceRef="U_RegStart" targetRef="U_RegSubmit" />
    <sequenceFlow id="U2" sourceRef="U_RegSubmit" targetRef="U_RegWait" />
    <sequenceFlow id="U5" sourceRef="U_RegOK" targetRef="U_RegDone" />
    <sequenceFlow id="U4" sourceRef="U_RegWait" targetRef="U_RegFail" />
    <sequenceFlow id="U6" sourceRef="U_RegFail" targetRef="U_RegRejected" />
    <sequenceFlow id="U7" sourceRef="U_LoginStart" targetRef="U_LoginSubmit" />
    <sequenceFlow id="U8" sourceRef="U_LoginSubmit" targetRef="U_LoginReceive" />
    <sequenceFlow id="U9" sourceRef="U_LoginReceive" targetRef="U_LoginEnd" />
    <sequenceFlow id="U3" sourceRef="U_RegWait" targetRef="U_RegOK" />
  </process>
  <process id="Proc_System" isExecutable="false">
    <laneSet id="LS_System">
      <lane id="L_System" name="Система">
        <flowNodeRef>S_RegCheck</flowNodeRef>
        <flowNodeRef>S_CheckLock</flowNodeRef>
        <flowNodeRef>S_RegStart</flowNodeRef>
        <flowNodeRef>S_RegValid</flowNodeRef>
        <flowNodeRef>S_RegFail</flowNodeRef>
        <flowNodeRef>S_RegRejected</flowNodeRef>
        <flowNodeRef>S_Create</flowNodeRef>
        <flowNodeRef>S_RegOK</flowNodeRef>
        <flowNodeRef>S_RegDone</flowNodeRef>
        <flowNodeRef>S_LoginStart</flowNodeRef>
        <flowNodeRef>S_Locked</flowNodeRef>
        <flowNodeRef>S_Verify</flowNodeRef>
        <flowNodeRef>S_SendBlocked</flowNodeRef>
        <flowNodeRef>S_BlockedEnd</flowNodeRef>
        <flowNodeRef>S_Valid</flowNodeRef>
        <flowNodeRef>S_Increment</flowNodeRef>
        <flowNodeRef>S_Open</flowNodeRef>
        <flowNodeRef>S_Limit</flowNodeRef>
        <flowNodeRef>S_SendResult</flowNodeRef>
        <flowNodeRef>S_Block</flowNodeRef>
        <flowNodeRef>S_LoginDone</flowNodeRef>
        <flowNodeRef>S_SendBlock</flowNodeRef>
        <flowNodeRef>S_Timer</flowNodeRef>
        <flowNodeRef>S_Unblock</flowNodeRef>
        <flowNodeRef>S_Unblocked</flowNodeRef>
      </lane>
    </laneSet>
    <task id="S_RegCheck" name="Перевірити унікальність логіна, збіг і складність пароля">
      <incoming>R1</incoming>
      <outgoing>R2</outgoing>
    </task>
    <task id="S_CheckLock" name="Перевірити стан блокування">
      <incoming>L1</incoming>
      <outgoing>L2</outgoing>
    </task>
    <startEvent id="S_RegStart" name="Отримано дані реєстрації">
      <outgoing>R1</outgoing>
      <messageEventDefinition id="S_RegStart_definition" messageRef="M_RegRequest" />
    </startEvent>
    <exclusiveGateway id="S_RegValid" name="Дані валідні й логін вільний?" default="R4">
      <incoming>R2</incoming>
      <outgoing>R3</outgoing>
      <outgoing>R4</outgoing>
    </exclusiveGateway>
    <sendTask id="S_RegFail" name="Повідомити про помилку реєстрації" messageRef="M_RegFail">
      <incoming>R4</incoming>
      <outgoing>R7</outgoing>
    </sendTask>
    <endEvent id="S_RegRejected" name="Реєстрацію відхилено">
      <incoming>R7</incoming>
    </endEvent>
    <task id="S_Create" name="Створити обліковий запис">
      <incoming>R3</incoming>
      <outgoing>R5</outgoing>
    </task>
    <sendTask id="S_RegOK" name="Повідомити про успішну реєстрацію" messageRef="M_RegOK">
      <incoming>R5</incoming>
      <outgoing>R6</outgoing>
    </sendTask>
    <endEvent id="S_RegDone" name="Обліковий запис створено">
      <incoming>R6</incoming>
    </endEvent>
    <startEvent id="S_LoginStart" name="Отримано дані входу">
      <outgoing>L1</outgoing>
      <messageEventDefinition id="S_LoginStart_definition" messageRef="M_LoginRequest" />
    </startEvent>
    <exclusiveGateway id="S_Locked" name="Обліковий запис заблокований?" default="L4">
      <incoming>L2</incoming>
      <outgoing>L3</outgoing>
      <outgoing>L4</outgoing>
    </exclusiveGateway>
    <task id="S_Verify" name="Перевірити облікові дані">
      <incoming>L4</incoming>
      <outgoing>L5</outgoing>
    </task>
    <sendTask id="S_SendBlocked" name="Повідомити про чинне блокування" messageRef="M_LoginResult">
      <incoming>L3</incoming>
      <outgoing>L17</outgoing>
    </sendTask>
    <endEvent id="S_BlockedEnd" name="Вхід заборонено">
      <incoming>L17</incoming>
    </endEvent>
    <exclusiveGateway id="S_Valid" name="Облікові дані вірні?" default="L7">
      <incoming>L5</incoming>
      <outgoing>L6</outgoing>
      <outgoing>L7</outgoing>
    </exclusiveGateway>
    <task id="S_Increment" name="Збільшити лічильник невдалих спроб">
      <incoming>L7</incoming>
      <outgoing>L9</outgoing>
    </task>
    <task id="S_Open" name="Відкрити сесію і скинути лічильник">
      <incoming>L6</incoming>
      <outgoing>L8</outgoing>
    </task>
    <exclusiveGateway id="S_Limit" name="Досягнуто трьох невдалих спроб?" default="L11">
      <incoming>L9</incoming>
      <outgoing>L10</outgoing>
      <outgoing>L11</outgoing>
    </exclusiveGateway>
    <sendTask id="S_SendResult" name="Повідомити результат входу" messageRef="M_LoginResult">
      <incoming>L8</incoming>
      <incoming>L10</incoming>
      <outgoing>L12</outgoing>
    </sendTask>
    <task id="S_Block" name="Заблокувати обліковий запис">
      <incoming>L11</incoming>
      <outgoing>L13</outgoing>
    </task>
    <endEvent id="S_LoginDone" name="Результат входу надіслано">
      <incoming>L12</incoming>
    </endEvent>
    <sendTask id="S_SendBlock" name="Повідомити про блокування" messageRef="M_LoginResult">
      <incoming>L13</incoming>
      <outgoing>L14</outgoing>
    </sendTask>
    <intermediateCatchEvent id="S_Timer" name="Минуло 15 хвилин">
      <incoming>L14</incoming>
      <outgoing>L15</outgoing>
      <timerEventDefinition id="S_Timer_timer">
        <timeDuration xsi:type="tFormalExpression">PT15M</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <task id="S_Unblock" name="Зняти блокування і скинути лічильник">
      <incoming>L15</incoming>
      <outgoing>L16</outgoing>
    </task>
    <endEvent id="S_Unblocked" name="Блокування знято">
      <incoming>L16</incoming>
    </endEvent>
    <sequenceFlow id="R1" sourceRef="S_RegStart" targetRef="S_RegCheck" />
    <sequenceFlow id="R2" sourceRef="S_RegCheck" targetRef="S_RegValid" />
    <sequenceFlow id="L1" sourceRef="S_LoginStart" targetRef="S_CheckLock" />
    <sequenceFlow id="L2" sourceRef="S_CheckLock" targetRef="S_Locked" />
    <sequenceFlow id="R3" name="Так" sourceRef="S_RegValid" targetRef="S_Create" />
    <sequenceFlow id="R4" name="Ні" sourceRef="S_RegValid" targetRef="S_RegFail" />
    <sequenceFlow id="R7" sourceRef="S_RegFail" targetRef="S_RegRejected" />
    <sequenceFlow id="R5" sourceRef="S_Create" targetRef="S_RegOK" />
    <sequenceFlow id="R6" sourceRef="S_RegOK" targetRef="S_RegDone" />
    <sequenceFlow id="L3" name="Так" sourceRef="S_Locked" targetRef="S_SendBlocked" />
    <sequenceFlow id="L4" name="Ні" sourceRef="S_Locked" targetRef="S_Verify" />
    <sequenceFlow id="L5" sourceRef="S_Verify" targetRef="S_Valid" />
    <sequenceFlow id="L17" sourceRef="S_SendBlocked" targetRef="S_BlockedEnd" />
    <sequenceFlow id="L6" name="Так" sourceRef="S_Valid" targetRef="S_Open" />
    <sequenceFlow id="L7" name="Ні" sourceRef="S_Valid" targetRef="S_Increment" />
    <sequenceFlow id="L9" sourceRef="S_Increment" targetRef="S_Limit" />
    <sequenceFlow id="L8" sourceRef="S_Open" targetRef="S_SendResult" />
    <sequenceFlow id="L10" name="Ні" sourceRef="S_Limit" targetRef="S_SendResult" />
    <sequenceFlow id="L11" name="Так" sourceRef="S_Limit" targetRef="S_Block" />
    <sequenceFlow id="L12" sourceRef="S_SendResult" targetRef="S_LoginDone" />
    <sequenceFlow id="L13" sourceRef="S_Block" targetRef="S_SendBlock" />
    <sequenceFlow id="L14" sourceRef="S_SendBlock" targetRef="S_Timer" />
    <sequenceFlow id="L15" sourceRef="S_Timer" targetRef="S_Unblock" />
    <sequenceFlow id="L16" sourceRef="S_Unblock" targetRef="S_Unblocked" />
  </process>
  <message id="M_RegRequest" name="Дані реєстрації" />
  <message id="M_RegOK" name="Реєстрація успішна" />
  <message id="M_RegFail" name="Реєстрацію відхилено" />
  <message id="M_LoginRequest" name="Дані входу" />
  <message id="M_LoginResult" name="Результат входу" />
