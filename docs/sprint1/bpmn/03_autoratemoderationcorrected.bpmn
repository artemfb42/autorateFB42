<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AutoRate_Moderation" targetNamespace="https://autorate.example/bpmn/moderation" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.30.1">
  <message id="M_New" name="Новий коментар на модерацію" />
  <message id="M_Report" name="Скарга на коментар" />
  <message id="M_Warning" name="Попередження користувачу" />
  <collaboration id="Collaboration_Moderation">
    <participant id="P_AutoRate" name="АвтоРейт" processRef="Proc_AutoRate" />
    <participant id="P_User" name="Користувач" processRef="Proc_User" />
    <messageFlow id="MF_Warning" sourceRef="Warn" targetRef="UserReceives" messageRef="M_Warning" />
  </collaboration>
  <process id="Proc_AutoRate" isExecutable="false">
    <laneSet id="LaneSet_AutoRate">
      <lane id="Lane_System" name="Система">
        <flowNodeRef>Approve</flowNodeRef>
        <flowNodeRef>LogApprove</flowNodeRef>
        <flowNodeRef>Approved</flowNodeRef>
        <flowNodeRef>Hide</flowNodeRef>
        <flowNodeRef>LogHide</flowNodeRef>
        <flowNodeRef>Hidden</flowNodeRef>
        <flowNodeRef>Delete</flowNodeRef>
        <flowNodeRef>Warn</flowNodeRef>
        <flowNodeRef>Repeat</flowNodeRef>
        <flowNodeRef>LogDelete</flowNodeRef>
        <flowNodeRef>Deleted</flowNodeRef>
        <flowNodeRef>Block</flowNodeRef>
        <flowNodeRef>LogBlock</flowNodeRef>
        <flowNodeRef>Blocked</flowNodeRef>
      </lane>
      <lane id="Lane_Moderator" name="Модератор">
        <flowNodeRef>New</flowNodeRef>
        <flowNodeRef>Report</flowNodeRef>
        <flowNodeRef>Open</flowNodeRef>
        <flowNodeRef>Review</flowNodeRef>
        <flowNodeRef>Decision</flowNodeRef>
      </lane>
    </laneSet>
    <task id="Approve" name="Позначити коментар як схвалений">
      <incoming>F05</incoming>
      <outgoing>F06</outgoing>
    </task>
    <task id="LogApprove" name="Записати схвалення у журнал">
      <incoming>F06</incoming>
      <outgoing>F07</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_0g229q3">
        <targetRef>Journal</targetRef>
      </dataOutputAssociation>
    </task>
    <endEvent id="Approved" name="Коментар схвалено">
      <incoming>F07</incoming>
    </endEvent>
    <task id="Hide" name="Приховати коментар">
      <incoming>F08</incoming>
      <outgoing>F09</outgoing>
    </task>
    <task id="LogHide" name="Записати приховування у журнал">
      <incoming>F09</incoming>
      <outgoing>F10</outgoing>
    </task>
    <endEvent id="Hidden" name="Коментар приховано">
      <incoming>F10</incoming>
    </endEvent>
    <task id="Delete" name="Видалити коментар">
      <incoming>F11</incoming>
      <outgoing>F12</outgoing>
    </task>
    <sendTask id="Warn" name="Надіслати користувачу попередження" messageRef="M_Warning">
      <incoming>F12</incoming>
      <outgoing>F13</outgoing>
    </sendTask>
    <exclusiveGateway id="Repeat" name="Це повторне порушення?" default="F14">
      <incoming>F13</incoming>
      <outgoing>F14</outgoing>
      <outgoing>F16</outgoing>
    </exclusiveGateway>
    <task id="LogDelete" name="Записати видалення й попередження у журнал">
      <incoming>F14</incoming>
      <outgoing>F15</outgoing>
    </task>
    <endEvent id="Deleted" name="Коментар видалено з попередженням">
      <incoming>F15</incoming>
    </endEvent>
    <task id="Block" name="Заблокувати користувача">
      <incoming>F16</incoming>
      <outgoing>F17</outgoing>
    </task>
    <task id="LogBlock" name="Записати блокування у журнал">
      <incoming>F17</incoming>
      <outgoing>F18</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_1g11blr">
        <targetRef>Journal</targetRef>
      </dataOutputAssociation>
    </task>
    <endEvent id="Blocked" name="Користувача заблоковано">
      <incoming>F18</incoming>
    </endEvent>
    <dataObjectReference id="Journal" name="Журнал модерації" dataObjectRef="ModerationJournal" />
    <dataObject id="ModerationJournal" />
    <startEvent id="New" name="Отримано новий коментар на модерацію">
      <outgoing>F01</outgoing>
      <messageEventDefinition id="New_MessageEvent" messageRef="M_New" />
    </startEvent>
    <startEvent id="Report" name="Отримано скаргу на коментар">
      <outgoing>F02</outgoing>
      <messageEventDefinition id="Report_MessageEvent" messageRef="M_Report" />
    </startEvent>
    <task id="Open" name="Відкрити чергу та прочитати коментар">
      <incoming>F01</incoming>
      <incoming>F02</incoming>
      <outgoing>F03</outgoing>
    </task>
    <task id="Review" name="Перевірити коментар і репутацію автора">
      <incoming>F03</incoming>
      <outgoing>F04</outgoing>
    </task>
    <exclusiveGateway id="Decision" name="Яке рішення щодо коментаря?" default="F11">
      <incoming>F04</incoming>
      <outgoing>F05</outgoing>
      <outgoing>F08</outgoing>
      <outgoing>F11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="F05" name="Схвалити" sourceRef="Decision" targetRef="Approve" />
    <sequenceFlow id="F06" sourceRef="Approve" targetRef="LogApprove" />
    <sequenceFlow id="F07" sourceRef="LogApprove" targetRef="Approved" />
    <sequenceFlow id="F08" name="Приховати" sourceRef="Decision" targetRef="Hide" />
    <sequenceFlow id="F09" sourceRef="Hide" targetRef="LogHide" />
    <sequenceFlow id="F10" sourceRef="LogHide" targetRef="Hidden" />
    <sequenceFlow id="F11" name="Видалити з попередженням" sourceRef="Decision" targetRef="Delete" />
    <sequenceFlow id="F12" sourceRef="Delete" targetRef="Warn" />
    <sequenceFlow id="F13" sourceRef="Warn" targetRef="Repeat" />
    <sequenceFlow id="F14" name="Ні" sourceRef="Repeat" targetRef="LogDelete" />
    <sequenceFlow id="F16" name="Так" sourceRef="Repeat" targetRef="Block" />
    <sequenceFlow id="F15" sourceRef="LogDelete" targetRef="Deleted" />
    <sequenceFlow id="F17" sourceRef="Block" targetRef="LogBlock" />
    <sequenceFlow id="F18" sourceRef="LogBlock" targetRef="Blocked" />
    <sequenceFlow id="F01" sourceRef="New" targetRef="Open" />
    <sequenceFlow id="F02" sourceRef="Report" targetRef="Open" />
    <sequenceFlow id="F03" sourceRef="Open" targetRef="Review" />
    <sequenceFlow id="F04" sourceRef="Review" targetRef="Decision" />
    <association id="A2" sourceRef="LogHide" targetRef="Journal" />
    <association id="A3" sourceRef="LogDelete" targetRef="Journal" />
  </process>
  <process id="Proc_User" isExecutable="false">
    <startEvent id="UserReceives" name="Отримано попередження від модератора">
      <outgoing>F19</outgoing>
      <messageEventDefinition id="UserReceives_MessageEvent" messageRef="M_Warning" />
    </startEvent>
    <endEvent id="UserRead" name="Ознайомлено з попередженням">
      <incoming>F19</incoming>
    </endEvent>
    <sequenceFlow id="F19" sourceRef="UserReceives" targetRef="UserRead" />
  </process>
